{
  "name": "japanese-writing-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "description": "日本語文章をコードのように静的解析する、ブラウザ完結型 Linter / Formatter",
  "scripts": {
    "dev": "vite --port 3000 --host --strictPort 2>&1 | tee dev.log",
    "build": "vite build",
    "build:pages": "vite build --base=/japanese_text/",
    "preview": "vite preview --port 3000 --host",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "echo 'no database required (frontend-only app)'",
    "bench:analysis": "bun scripts/benchmark-analysis.ts --json",
    "bench:smoke": "bun scripts/benchmark-analysis.ts --smoke",
    "dictionaries:generate": "bun scripts/build-dictionary-assets.ts",
    "dictionaries:check": "bun scripts/build-dictionary-assets.ts --check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@textlint/textlint-plugin-text": "^15.8.0",
    "assert": "^2.1.0",
    "codemirror": "^6.0.2",
    "solid-js": "^1.9.17",
    "textlint-rule-no-hankaku-kana": "^2.0.1",
    "textlint-rule-no-nfd": "^2.0.2",
    "textlint-rule-sentence-length": "^5.2.1"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  }
}
